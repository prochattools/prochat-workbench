{
  "name": "workbench",
  "version": "1.3.15-beta",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "ProChat Workbench Local: guarded local execution for ChatGPT-first repository workflows.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "js-yaml": "3.15.0",
      "fast-uri@3": "3.1.4",
      "fast-uri@4": "4.1.1",
      "sharp": ">=0.35.0"
    }
  },
  "scripts": {
    "test": "pnpm verify:shared-source-boundary && pnpm verify:run-command-contract && pnpm verify:controlled-workflow-topology && pnpm verify:controlled-workflow-canonicalization && pnpm verify:controlled-n8n-wrapper-contract && pnpm verify:capability-grants && pnpm verify:capability-mutation-dispatch-store && pnpm verify:controlled-workflow-migration-state && pnpm verify:n8n-workflow-migration-executor && pnpm verify:n8n-workflow-migration-capability && pnpm verify:cli-run-command-adapter && pnpm verify:cli-run-command-boundary && pnpm verify:lite-source-hydration && pnpm verify:workbench-mcp && pnpm verify:workbench-mcp-auth && pnpm verify:restart-detachment && pnpm verify:public-script-closure",
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint",
    "generate:openapi-chatgpt": "node scripts/generate-openapi-chatgpt.mjs",
    "verify:dashboard": "node scripts/verify-dashboard.mjs",
    "verify:public-scope": "node scripts/audit-public-scope.mjs",
    "verify:shared-source-boundary": "pnpm --dir packages/shared build && ./packages/cli/node_modules/.bin/tsx scripts/verify-shared-source-boundary.ts",
    "verify:public-script-closure": "node scripts/verify-public-script-closure.mjs",
    "verify:run-command-contract": "./packages/cli/node_modules/.bin/tsx scripts/verify-run-command-contract.ts",
    "verify:controlled-workflow-topology": "./packages/cli/node_modules/.bin/tsx scripts/verify-controlled-workflow-topology.ts",
    "verify:controlled-workflow-canonicalization": "./packages/cli/node_modules/.bin/tsx scripts/verify-controlled-workflow-canonicalization.ts",
    "verify:controlled-workflow-migration-state": "./packages/cli/node_modules/.bin/tsx scripts/verify-controlled-workflow-migration-state.ts",
    "verify:controlled-n8n-wrapper-contract": "./packages/cli/node_modules/.bin/tsx scripts/verify-controlled-n8n-wrapper-contract.ts",
    "verify:n8n-workflow-migration-executor": "./packages/cli/node_modules/.bin/tsx scripts/verify-n8n-workflow-migration-executor.ts",
    "verify:n8n-workflow-migration-capability": "./packages/cli/node_modules/.bin/tsx scripts/verify-n8n-workflow-migration-capability.ts",
    "verify:cli-run-command-adapter": "./packages/cli/node_modules/.bin/tsx scripts/verify-cli-run-command-adapter.ts",
    "verify:cli-run-command-boundary": "./packages/cli/node_modules/.bin/tsx scripts/verify-cli-run-command-boundary.ts",
    "verify:capability-grants": "./packages/cli/node_modules/.bin/tsx scripts/verify-capability-grants.ts",
    "verify:capability-operation-store": "./packages/cli/node_modules/.bin/tsx scripts/verify-capability-operation-store.ts",
    "verify:capability-mutation-dispatch-store": "./packages/cli/node_modules/.bin/tsx scripts/verify-capability-mutation-dispatch-store.ts",
    "verify:lite-source-hydration": "./packages/cli/node_modules/.bin/tsx scripts/verify-lite-source-hydration.ts",
    "verify:workbench-mcp": "pnpm --dir packages/mcp verify",
    "verify:workbench-mcp-auth": "./packages/cli/node_modules/.bin/tsx --tsconfig apps/web/tsconfig.json apps/web/src/__tests__/actions/workbench-mcp-auth.test.ts",
    "verify:command-runner": "./packages/cli/node_modules/.bin/tsx scripts/verify-command-runner.ts",
    "verify:packet-lifecycle": "WORKBENCH_CONFIG_DIR=$(mktemp -d) ./packages/cli/node_modules/.bin/tsx scripts/verify-packet-lifecycle.ts",
    "verify:validation-jobs": "./packages/cli/node_modules/.bin/tsx scripts/verify-validation-jobs.ts && pnpm --dir packages/cli type-check",
    "verify:search-architecture": "./packages/cli/node_modules/.bin/tsx scripts/verify-search-architecture.ts",
    "verify:branch-activation": "./packages/cli/node_modules/.bin/tsx scripts/verify-branch-activation.ts",
    "verify:write-policy": "./packages/cli/node_modules/.bin/tsx scripts/verify-write-policy.ts",
    "verify:gpt-actions": "node scripts/verify-custom-gpt-actions.mjs",
    "verify:gpt-contract": "node scripts/verify-custom-gpt-actions.mjs",
    "test:env-compatibility": "bash scripts/test-shell-env-compat.sh && ./packages/cli/node_modules/.bin/tsx apps/web/src/__tests__/env-compat.test.ts",
    "test:workbench-timeout": "./packages/cli/node_modules/.bin/tsx apps/web/src/__tests__/actions/timeout.test.ts",
    "test:workbench-response-size": "./packages/cli/node_modules/.bin/tsx apps/web/src/__tests__/actions/response-size.test.ts",
    "test:cli-compatibility": "node packages/cli/tests/cli-compatibility.test.js",
    "local:status": "bash scripts/workbench-local-stack.sh verify",
    "local:start": "bash scripts/workbench-local-stack.sh start",
    "local:stop": "bash scripts/workbench-local-stack.sh stop",
    "local:restart": "bash scripts/workbench-local-stack.sh restart",
    "local:restart:fresh": "bash scripts/workbench-local-stack.sh restart",
    "local:restart:fresh:detached": "bash scripts/workbench-local-stack.sh restart",
    "local:restart:detached:status": "bash scripts/workbench-local-stack.sh verify",
    "verify:restart-detachment": "node scripts/verify-workbench-detached-lifecycle.mjs",
    "local:rebuild-web": "bash scripts/workbench-local-stack.sh restart",
    "local:verify": "bash scripts/workbench-local-stack.sh verify",
    "test:freshness-metadata": "bash scripts/test-freshness-metadata.sh",
    "start:prod": "bash scripts/start-prod.sh"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "0.27.7",
    "typescript": "^5.0.0"
  }
}
